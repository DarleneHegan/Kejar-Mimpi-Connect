# Koneksi database Supabase (Postgres) - ambil dari Supabase Project Settings > Database > Connection string (URI, mode "Session" atau "Transaction")
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres

# Secret key untuk JWT admin (buat string random panjang, jangan dibagikan)
JWT_SECRET_KEY=ganti-dengan-string-random-yang-panjang-dan-rahasia
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Kredensial admin awal (dipakai oleh script seed untuk membuat akun admin pertama)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ubah-password-ini

# Base URL frontend (dipakai untuk generate link di QR code jika diperlukan)
FRONTEND_BASE_URL=http://localhost:3000
